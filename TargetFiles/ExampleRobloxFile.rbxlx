						<ProtectedString name="Source"><![CDATA[local module = {}

function module.Execute(multiplier)
	wait(3 * multiplier)

	script.Parent.Size = Vector3.new(2,2,2)

	wait(2 * multiplier)

	script.Parent.Size = Vector3.new(3,3,3)

	wait(2 * multiplier)

	script.Parent.Size = Vector3.new(0.5,0.5,0.5)
end

return module
]]></ProtectedString>
